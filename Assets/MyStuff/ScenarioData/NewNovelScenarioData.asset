    blocks:
    - speakerName: 
      bodyText: "\u30DE\u30C6\u30A3\u30E9\u30E0\u30FB\u30DF\u30B9\u30E9\u541B\u3068\u4E91\u3048\u3070\u3001\u3082\u3046\u7686\u3055\u3093\u306E\u4E2D\u306B\u3082\u3001\u5FA1\u5B58\u3058\u306E\u65B9\u304C\u5C11\u306A\u304F\u306A\u3044\u304B\u3082\u77E5\u308C\u307E\u305B\u3093\u3002"
