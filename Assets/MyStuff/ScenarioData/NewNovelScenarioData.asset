      characterSprite: {fileID: -1898900564960642027, guid: e7d739121c447584b991610553ffe542, type: 3}
      visible: 0
    blocks:
    - speakerName: 
      bodyText: " \u79C1\u306F\u3061\u3087\u3046\u3069\u4E00\u6708\u3070\u304B\u308A\u4EE5\u524D\u304B\u3089\u3001\u3042\u308B\u53CB\u4EBA\u306E\u7D39\u4ECB\u3067\u30DF\u30B9\u30E9\u541B\u3068\u4EA4\u969B\u3057\u3066\u3044\u307E\u3057\u305F\u304C\u3001\u653F\u6CBB\u7D4C\u6E08\u306E\u554F\u984C\u306A\u3069\u306F\u3044\u308D\u3044\u308D\u8B70\u8AD6\u3057\u305F\u3053\u3068\u304C\u3042\u3063\u3066\u3082\u3001\u809D\u814E\u306E\u9B54\u8853\u3092\u4F7F\u3046\u6642\u306B\u306F\u3001\u307E\u3060\u4E00\u5EA6\u3082\u5C45\u5408\u308F\u305B\u305F\u3053\u3068\u304C\u3042\u308A\u307E\u305B\u3093\u3002"
      standingChanges: []
      hidePositions: 
      hideAllStandings: 0
    - speakerName: 
      bodyText: "\u305D\u3053\u3067\u4ECA\u591C\u306F\u524D\u4EE5\u3066\u3001\u9B54\u8853\u3092\u4F7F\u3063\u3066\u898B\u305B\u3066\u304F\u308C\u308B\u3088\u3046\u306B\u3001\u624B\u7D19\u3067\u983C\u3093\u3067\u304A\u3044\u3066\u304B\u3089\u3001\u5F53\u6642\u30DF\u30B9\u30E9\u541B\u306E\u4F4F\u3093\u3067\u3044\u305F\u3001\u5BC2\u3057\u3044\u5927\u68EE\u306E\u8857\u5916\u308C\u307E\u3067\n\u4EBA\u529B\u8ECA\u3092\u6025\u304C\u305B\u3066\u304D\u305F\u306E\u3067\u3059\u3002"
