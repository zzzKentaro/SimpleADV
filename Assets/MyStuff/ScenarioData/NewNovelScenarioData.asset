    blocks:
    - speakerName: 
      bodyText: " \u3042\u308B\u6642\u96E8\u306E\u964D\u308B\u6669\u306E\u4E8B\u3067\u3059\u3002\n
        \u79C1\u3092\u4E57\u305B\u305F\u4EBA\u529B\u8ECA\u306F\u3001\u4F55\u5EA6\u3082\u5927\u68EE\u754C\u9688\u306E\u967A\u3057\u3044\u5742\u3092\u4E0A\u3063\u305F\u308A\u4E0B\u3063\u305F\u308A\u3057\u3066\u3001\u3084\u3063\u3068\u7AF9\u85EA\u306B\u56F2\u307E\u308C\u305F\u3001\u5C0F\u3055\u306A\u897F\u6D0B\u9928\u306E\u524D\u306B\u68B6\u68D2\u3092\u4E0B\u3057\u307E\u3057\u305F"
