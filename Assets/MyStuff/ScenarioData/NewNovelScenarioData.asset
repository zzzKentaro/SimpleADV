        characterSprite: {fileID: 3415416665201964701, guid: a1067ce4b35e17d4d885c2de151cb36b, type: 3}
        visible: 1
      hidePositions: 
      hideAllStandings: 1
    - speakerName: 
      bodyText: " \u30DF\u30B9\u30E9\u541B\u306F\u6C38\u5E74\u5370\u5EA6\u306E\u72EC\u7ACB\u3092\u8A08\u3063\u3066\u3044\u308B\u30AB\u30EB\u30AB\u30C3\u30BF\u751F\u308C\u306E\u611B\u56FD\u8005\u3067\u3001\n
        \u540C\u6642\u306B\u30CF\u30C3\u30B5\u30F3\u30FB\u30AB\u30F3\u3068\u3044\u3046\u540D\u9AD8\u3044\u5A46\u7F85\u9580\u306E\u79D8\u6CD5\u3092\u5B66\u3093\u3060\u3001\u6B73\u306E\u82E5\u3044\u9B54\u8853\u306E\u5927\u5BB6\u306A\u306E\u3067\u3059\u3002"
      standingChanges:
      - position: 1
