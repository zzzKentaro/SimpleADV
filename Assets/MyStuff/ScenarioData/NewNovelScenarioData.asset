    - speakerName: 
      bodyText: "\u300C\u3044\u3089\u3063\u3057\u3083\u3044\u307E\u3059\u3002\u5148\u307B\u3069\u304B\u3089\u3042\u306A\u305F\u69D8\u3092\u5FA1\u5F85\u3061\u304B\u306D\u3067\u3054\u3056\u3044\u307E\u3057\u305F\u3002\u300D\n
